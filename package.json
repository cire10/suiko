{
  "name": "specreview",
  "version": "0.1.0",
  "description": "Iterative, commentable, versioned review loop for AI-written HTML and Markdown specs",
  "type": "module",
  "bin": { "specreview": "bin/specreview.js" },
  "engines": { "node": ">=20.19" },
  "files": ["bin", "src", "integrations", ".claude-plugin", "README.md", "docs"],
  "scripts": {
    "test": "node --test \"test/unit/**/*.test.js\" \"test/integration/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "test:guest": "node --test \"test/guest/**/*.test.mjs\"",
    "test:ui": "node --test \"test/e2e/**/*.test.mjs\" && playwright test",
    "e2e": "playwright test",
    "check": "npm test && npm run test:guest"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "approx-string-match": "2.0.1",
    "chokidar": "5.0.0",
    "diff": "9.0.0",
    "dompurify": "3.4.16",
    "github-markdown-css": "5.9.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-string": "3.0.1",
    "highlight.js": "11.12.0",
    "htm": "3.1.1",
    "katex": "0.16.47",
    "marked": "18.1.0",
    "mermaid": "12.1.0",
    "modern-screenshot": "4.7.0",
    "parse5": "7.3.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  },
  "license": "MIT"
}
